Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # "/" is a real directory. Without this rule, RewriteCond !-d skips
    # the front-controller rewrite and Options -Indexes returns 403 when
    # DirectoryIndex is not applied.
    RewriteRule ^$ index.php [QSA,L]

    # Uploaded files must never execute as PHP.
    RewriteRule ^uploads/.*\.(?i:php[0-9]?|phtml|phar)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
