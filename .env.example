
; Copy this file to .env ON THE SERVER (FTP), then fill secrets there.
; Never commit .env. Leave passwords and API keys empty in this example.

APP_NAME="TeleHealth PNG"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mbpha-telehealth.wuaze.com
APP_TIMEZONE=Pacific/Port_Moresby

DB_HOST=sql212.infinityfree.com
DB_PORT=3306
DB_NAME=if0_42747958_telehealth_db
DB_USER=if0_42747958
DB_PASS=

SESSION_NAME=TELEHEALTH_SESSION
SESSION_LIFETIME=7200

; ─────────────────────────────────────────────────────────
; Mail. Fill SMTP host/port/username/password only in server .env.
; InfinityFree: use Gmail SMTP (php mail() is restricted).
; Typical Gmail values: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_ENCRYPTION=tls
; MAIL_USERNAME=telehealth76@gmail.com
; MAIL_PASSWORD = Gmail App Password (server .env only)
; ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=telehealth76@gmail.com
MAIL_FROM_NAME=TeleHealth PNG

; ─────────────────────────────────────────────────────────
; Daily.co. Put the live key and subdomain only in server .env.
; ─────────────────────────────────────────────────────────
DAILY_API_KEY=
DAILY_DOMAIN=

; ─────────────────────────────────────────────────────────
; Google Identity Services. Web client ID only. No client secret.
; Add https://mbpha-telehealth.wuaze.com as an Authorized JavaScript origin.
; ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

; ─────────────────────────────────────────────────────────
; Doctor invitations. Empty values use application defaults (24 / 5 / 8).
; ─────────────────────────────────────────────────────────
DOCTOR_INVITE_TOKEN_TTL_HOURS=
DOCTOR_INVITE_RESEND_COOLDOWN_MINUTES=
DOCTOR_INVITE_MAX_SENDS_PER_DAY=
