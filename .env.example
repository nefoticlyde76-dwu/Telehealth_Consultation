; Copy this file to .env and fill in local values.
; Never commit .env. Leave passwords and API keys empty in this example.
; On DigitalOcean App Platform, set the same keys as App-Level env vars instead.
;
; Production App Platform values (do not put passwords or API keys in Git):
;   APP_ENV=production
;   APP_DEBUG=false
;   APP_URL=https://sea-turtle-app-jf58g.ondigitalocean.app
;   DB_HOST=10.126.0.2
;   DB_PORT=3306
;   DB_NAME=telehealth_db
;   DB_USER=telehealth_app
;   DB_PASS=   (encrypted App-Level env var only)
;   DAILY_DOMAIN=mbphatelehealth.daily.co

APP_NAME="MBPHA TeleHealth Consultation System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Telehealth_Consultation_System/public
APP_TIMEZONE=Pacific/Port_Moresby

DB_HOST=localhost
DB_PORT=3306
DB_NAME=telehealth_db
DB_USER=root
DB_PASS=

SESSION_NAME=TELEHEALTH_SESSION
SESSION_LIFETIME=7200

; ─────────────────────────────────────────────────────────
; Mail. Fill SMTP credentials only in .env.
; Typical Gmail values: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_ENCRYPTION=tls
; ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TeleHealth PNG

; ─────────────────────────────────────────────────────────
; Daily.co Video Consultation
; Generate a restricted API key from your Daily dashboard:
;   https://dashboard.daily.co/developers/api-keys
; DAILY_DOMAIN = your Daily subdomain (no protocol, no trailing slashes)
; NEVER commit secrets. The real key must exist ONLY in .env locally.
; ─────────────────────────────────────────────────────────
DAILY_API_KEY=
DAILY_DOMAIN=

; ─────────────────────────────────────────────────────────
; Google Identity Services. Web client ID only. No client secret.
; ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

; ─────────────────────────────────────────────────────────
; Doctor invitations. Empty values use application defaults (24 / 5 / 8).
; ─────────────────────────────────────────────────────────
DOCTOR_INVITE_TOKEN_TTL_HOURS=
DOCTOR_INVITE_RESEND_COOLDOWN_MINUTES=
DOCTOR_INVITE_MAX_SENDS_PER_DAY=

; ─────────────────────────────────────────────────────────
; Forgot password / reset password. Application defaults are 30 / 5.
; ─────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_MINUTES=5
