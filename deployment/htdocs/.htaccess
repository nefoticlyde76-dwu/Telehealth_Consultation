# InfinityFree production web root (htdocs/).
# Flattened layout: index.php, css/, js/, images/, and uploads/ sit here
# alongside app/, vendor/, and .env. HTTP access to private trees is denied;
# PHP require/include is unaffected.

Options -Indexes
DirectoryIndex index.php

# Block .env and variants (.env.example, .env.local, …).
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block Composer metadata and VCS/PHP config files at the document root.
<FilesMatch "(?i)^(composer\.(json|lock)|\.gitignore|\.gitattributes|\.user\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block dumps, docs, and config-like extensions if they are placed at the web root.
<FilesMatch "(?i)\.(sql|md|lock|ini|log|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Private source/data directories. Must run before !-f / !-d so Apache
    # does not execute existing PHP under app/ or vendor/.
    RewriteRule ^(?:app|vendor|routes|database|logs|tmp|cache|bin|storage)(/|$) - [F,L]

    # Git metadata if a .git directory is ever uploaded.
    RewriteRule ^\.git - [F,L]

    # Uploaded files must never execute as PHP.
    RewriteRule ^uploads/.*\.(?i:php[0-9]?|phtml|phar)$ - [F,L]

    # Front controller: missing paths go to index.php. Existing css/, js/,
    # images/, and non-PHP uploads/ files are served as static assets.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
