{
  "name": "milnebay/telehealth-consultation-system",
  "description": "Production-grade MBPHA TeleHealth Consultation System for Milne Bay Provincial Health Authority",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Final Year Capstone Project Team"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "dompdf/dompdf": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
